# Copy to sbx/.env (gitignored) and fill in; `chmod 600 sbx/.env`.
# Values are passed to the container at start and never stored in the image.
# No quotes around values.

# Claude: one of the two.
# Claude subscription: create with `claude setup-token` on the host.
CLAUDE_CODE_OAUTH_TOKEN=
# API key (billed per use).
#ANTHROPIC_API_KEY=

# GitHub: fine-grained token for this repository only
# (contents read/write, pull requests, actions read), with an expiry date.
GH_TOKEN=

# GitLab: project access token (api, write_repository), with an expiry date.
GITLAB_TOKEN=
GITLAB_HOST=gitlab.fe.sprecher-automation.com
